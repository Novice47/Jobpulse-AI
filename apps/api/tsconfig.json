{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@jobpulse/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@jobpulse/validation": ["../../packages/validation/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
